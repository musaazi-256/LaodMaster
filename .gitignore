!.env.example

# Vercel
.vercel

# Raw design-tool source files (Illustrator exports, autosaves) — not referenced by the
# app (it imports its actual icons from src/assets/), and the .ai/.tmp files here alone
# are 6.6MB+; keeping them out of git history keeps the repo lean.
Maps icons/

