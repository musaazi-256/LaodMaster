{
  "name": "loadmaster-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo": "node services/demo/server.mjs",
    "demo:reset": "node -e \"require('fs').rmSync('services/demo/data/state.json',{force:true})\" && node services/demo/server.mjs",
    "customer": "npm run start --workspace @loadmaster/customer",
    "driver": "npm run start --workspace @loadmaster/driver",
    "customer:ios": "node scripts/native.mjs customer ios",
    "customer:android": "node scripts/native.mjs customer android",
    "driver:ios": "node scripts/native.mjs driver ios",
    "driver:android": "node scripts/native.mjs driver android",
    "typecheck": "tsc --noEmit && tsc -p apps/admin/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint packages apps --max-warnings 0",
    "format": "prettier --write apps packages services tests scripts",
    "customer:web": "npm run web --workspace @loadmaster/customer",
    "driver:web": "npm run web --workspace @loadmaster/driver",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:flow": "npm run admin:build && node scripts/flow-check.mjs",
    "test:roles": "npm run admin:build && node scripts/role-check.mjs",
    "admin": "npm run dev --workspace @loadmaster/admin",
    "admin:build": "npm run build --workspace @loadmaster/admin",
    "build:android": "node scripts/build-native.mjs android",
    "build:ios": "node scripts/build-native.mjs ios",
    "emulator": "node scripts/emulator.mjs",
    "test:ios": "node scripts/ios-smoke.mjs",
    "handoff": "node scripts/handoff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
