# Postgres connection string for the API server (server/db.js).
#
# Local dev against the Postgres you already have running:
#   DATABASE_URL=postgresql://localhost:5432/loadmastr_dev
#
# Production (Supabase): Project Settings -> Database -> Connection string -> URI.
# Use the "Transaction" pooler connection (port 6543) for serverless/Vercel deployments —
# Vercel functions open a new connection per invocation, and Supabase's direct connection
# (port 5432) has a low connection-limit that serverless traffic exhausts quickly.
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
