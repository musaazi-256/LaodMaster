{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true
  },
  "include": [
    "apps/customer/**/*.ts",
    "apps/customer/**/*.tsx",
    "apps/driver/**/*.ts",
    "apps/driver/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
